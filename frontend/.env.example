# Server-side URL used by the Next.js API proxy to reach FastAPI.
# In Docker Compose this is set automatically to http://backend:8000.
BACKEND_URL=http://localhost:8000

# Password reset emails are sent by the Next.js server with nodemailer.
# Leave SMTP_HOST empty to fall back to returning the reset link in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Must match the backend's INTERNAL_API_KEY. In production this lets the proxy
# receive the reset link from the API so it can email it.
INTERNAL_API_KEY=

# Used in the reset email copy; keep in sync with the backend.
PASSWORD_RESET_EXPIRE_MINUTES=30