# ---------------------------------------------------------------------------
# DocuMind environment configuration
# Copy this file to .env at the repository root and fill in the values.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Local Docker Postgres (matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
# Supabase (optional): use the Session Pooler connection string, e.g.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Authentication --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when serving over HTTPS (production)
COOKIE_SECURE=false
# Password reset links expire after this many minutes
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Password reset email (Next.js + nodemailer) --------------------------
# The Next.js server loads this file in local development; Docker Compose
# passes these values to the frontend container. frontend/.env.local overrides.
# Without SMTP the reset link is returned by the API when ENVIRONMENT is not
# "production".
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=seelaboinasantosh13@gmail.com
SMTP_PASSWORD=zuowlhulmipbgbxp
SMTP_FROM=seelaboinasantosh13@gmail.com
SMTP_USE_TLS=true
# Shared secret between backend and Next.js. Required in production so the
# proxy can receive the reset link and email it via nodemailer.
INTERNAL_API_KEY=

# --- Frontend / CORS -------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Server-side URL the Next.js proxy uses to reach the backend
BACKEND_URL=http://localhost:8000

# --- LLM provider ----------------------------------------------------------
# "ollama" (local, default) or "gemini" (cloud API key required).
LLM_PROVIDER=ollama
# Docker Compose overrides this with http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:instruct
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192

# Gemini is only used when LLM_PROVIDER=gemini.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Chunking / retrieval --------------------------------------------------
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
MIN_CHUNK_TOKENS=50
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.2
MAX_UPLOAD_BYTES=10485760

# --- Storage ---------------------------------------------------------------
# Relative paths are resolved against the backend working directory.
DATA_DIR=data
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=documind_documents

# --- SciQ import (optional) ------------------------------------------------
SCIQ_IMPORT_EMAIL=
SCIQ_IMPORT_PASSWORD=